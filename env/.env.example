# EVA environment. Copy to env/.env (git-ignored) for local secrets; compose layers .env over this file.
# Variables are those of eva-dev-docs/03 section 5 plus the eval/mock extras marked below.
# agent
APP_ENV=dev
JWT_SECRET=dev-jwt-secret-key-must-be-at-least-32-chars-long!
DATABASE_URL=sqlite+aiosqlite:///./agent.db
WORKSPACE_ROOT=./workspace
SEED_ADMIN_EMAIL=admin@eva.local
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_USER_EMAIL=user@eva.local
SEED_USER_PASSWORD=UserPassword123!
# GMAIL_MODE: mock (default, required for evals) | real (needs the GOOGLE_* values + TOKEN_ENC_KEY)
GMAIL_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/gmail/callback
# Fernet key for refresh tokens. DEV-ONLY default below; generate your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_ENV=prod refuses to encrypt tokens without a real key.
TOKEN_ENC_KEY=dGhpc2lzYTMyeS1ieXRlcy1mZXJuZXQta2V5LTEyMzQ1Njc=
# real mode: comma-separated recipients allowed for gmail.send; empty = only the connected account itself
GMAIL_SEND_ALLOWLIST=
TELEGRAM_MODE=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWLIST=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
# Cloud model names have NO provider prefix and NO -cloud suffix (verified live): list yours with
#   curl -s -H "Authorization: Bearer $OLLAMA_API_KEY" https://ollama.com/api/tags
OLLAMA_MODEL=gpt-oss:20b
# web.search backend: mock (default; forced in eval) | ollama (Ollama web-search API, uses OLLAMA_API_KEY)
WEB_SEARCH_PROVIDER=mock
GUARD_TRANSPORT=inprocess
GUARD_SERVICE_URL=http://localhost:8100
GUARD_SERVICE_TOKEN=dev-guard-token
GUARD_PROFILE=full
MAX_STEPS=12

# --- eval / mock extras (backend) ---
# Failure injection: honoured ONLY when APP_ENV=eval (config refuses them elsewhere).
# EVA_FAIL_TIER2_DOWN=false
# EVA_FAIL_GUARD_UNREACHABLE=false
# EVA_FAIL_LAYA_TIMEOUT=false
# Share mock state (sent mail, drafts, HTTP log) across processes so `python -m env.mock.reset`
# resets a running API. Must be exported in the shell (not read from this file); compose sets it.
# MOCK_STATE_FILE=./env/mock/.state.json

# guard
GUARD_DATABASE_URL=sqlite:///./guard.db
T2_MODEL_PATH=./guard/models/t2.onnx
T2_MODEL_SHA256=
T2_HIGH_RISK_THRESHOLD=0.85
T3_BAND_LOW=0.30
T3_BAND_HIGH=0.85
BLOCK_THRESHOLD=0.85
T3_ENABLED=true
T3_TIMEOUT_MS=1500
T3_MAX_TEXT_CHARS=2000
ALIGN_ENABLED=true
ALIGN_TIMEOUT_MS=1500
DEFAULT_FAILURE_MODE=fail_closed
