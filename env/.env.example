# agent
APP_ENV=dev
JWT_SECRET=dev-jwt-secret-key-must-be-at-least-32-chars-long!
DATABASE_URL=sqlite+aiosqlite:///./agent.db
WORKSPACE_ROOT=./workspace
SEED_ADMIN_EMAIL=admin@eva.local
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_USER_EMAIL=user@eva.local
SEED_USER_PASSWORD=UserPassword123!
GMAIL_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/gmail/callback
TOKEN_ENC_KEY=dGhpc2lzYTMyeS1ieXRlcy1mZXJuZXQta2V5LTEyMzQ1Njc=
GMAIL_SEND_ALLOWLIST=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1
GUARD_TRANSPORT=inprocess
GUARD_SERVICE_URL=http://localhost:8100
GUARD_SERVICE_TOKEN=dev-guard-token
GUARD_PROFILE=full
MAX_STEPS=12

# guard
GUARD_DATABASE_URL=sqlite:///./guard.db
T2_MODEL_PATH=./guard/models/t2.onnx
T2_MODEL_SHA256=
T2_HIGH_RISK_THRESHOLD=0.85
T3_BAND_LOW=0.30
T3_BAND_HIGH=0.85
BLOCK_THRESHOLD=0.85
T3_ENABLED=true
T3_TIMEOUT_MS=1500
T3_MAX_TEXT_CHARS=2000
ALIGN_ENABLED=true
ALIGN_TIMEOUT_MS=1500
DEFAULT_FAILURE_MODE=fail_closed
